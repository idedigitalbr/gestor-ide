{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IDE Gestor",
  "version": "0.1.2",
  "identifier": "digital.suporteide.gestor",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:3005"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IDE Gestor",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "url": "https://gestor.suporteide.digital"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
